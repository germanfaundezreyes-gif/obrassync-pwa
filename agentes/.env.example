# Copia a .env solo para pruebas locales. En Railway, cárgalas en Variables. Nunca subas .env al repo.

# --- Servicio ---
PORT=8080
ADMIN_TOKEN=                     # clave larga y aleatoria para las rutas /admin

# --- Claude (API de Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFUERZO_GERENTE=medium   # low | medium | high
CLAUDE_ESFUERZO_AREAS=low

# --- ObrasSync (usuario de solo consulta para los agentes) ---
OBRASSYNC_EMAIL=
OBRASSYNC_PASSWORD=
# OBRASSYNC_TOKEN=               # alternativa al email/clave
# OBRASSYNC_API_URL=https://obrassync-backend-production.up.railway.app

# --- WhatsApp Business Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=                 # token permanente de un usuario del sistema
WA_APP_SECRET=                   # para validar la firma de los webhooks
WA_VERIFY_TOKEN=                 # texto que inventas y repites en Meta al registrar el webhook
WA_NUMEROS_AUTORIZADOS=          # ej. 56912345678,56987654321
WA_ACTIVADORES=@agente,@matfau   # en grupos, responde solo si el mensaje contiene una de estas
# WA_API_VERSION=v23.0

# --- Correo Microsoft 365 ---
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_BUZON=asistente@matfau.cl
CORREO_PERMITIDOS=matfau.cl      # dominios o direcciones a los que se responde
CORREO_INTERVALO_SEGUNDOS=60
